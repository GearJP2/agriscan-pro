# Copy this file to .env.ec2 on the EC2 instance and fill real values.
# Do not commit .env.ec2.

DEBUG=False
SECRET_KEY=change-this-to-a-random-secret-at-least-50-characters-long
ALLOWED_HOSTS=<ec2-public-ip>,localhost,127.0.0.1

DB_NAME=agriscan
DB_USER=agriscan_user
DB_PASSWORD=change-this-db-password

# Internal prototype over plain HTTP.
# Change these when you add HTTPS / a real frontend domain.
FORCE_SSL=False
JWT_REFRESH_COOKIE_SECURE=False
JWT_REFRESH_COOKIE_SAMESITE=Lax
CORS_ALLOWED_ORIGINS=http://<ec2-public-ip>,http://localhost:5173
CORS_ALLOW_ALL=False

# Keep async tasks off for the simplest one-box prototype.
ASYNC_TASKS_ENABLED=False
REDIS_URL=
USE_LOCAL_MEMORY_CACHE=True

# Gunicorn. t3.medium can usually run 2-3 workers.
WEB_WORKERS=2
BACKEND_HOST_PORT=80

# Optional admin bootstrap behavior.
INITIAL_ADMIN_EMAILS=
MONITOR_ACCESS_MIN_ROLE=research_assistant

# Optional integrations. Leave blank for prototype.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
